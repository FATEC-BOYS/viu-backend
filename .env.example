# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/viu"

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="substitua_por_uma_chave_aleatoria_de_no_minimo_32_caracteres"
JWT_EXPIRES_IN=7d

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000

# Rate limit global da API (default: 100 requisições por 15 minutes)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15 minutes

# URL pública do frontend (usada em links compartilhados)
FRONTEND_URL=http://localhost:3000

# Cloudflare R2 Storage
# Endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2_access_key_id>
R2_SECRET_ACCESS_KEY=<r2_secret_access_key>
R2_BUCKET=viu

# OpenAI (opcional — transcrição e TTS de feedbacks de áudio)
OPENAI_API_KEY=

# Resend (email transacional — recuperação de senha)
# Criar em: https://resend.com → API Keys
RESEND_API_KEY=
# Remetente verificado no Resend (deve ser um domínio seu)
EMAIL_FROM=VIU <noreply@seudominio.com>

# Cookies de sessão. 'lax' serve quando app e API compartilham o site
# registrável (viu.app / api.viu.app, ou localhost:3000 / localhost:3001) e já
# protege contra CSRF. Domínios diferentes exigem 'none' — que só funciona com
# HTTPS e deixa a guarda de origem como única defesa contra CSRF.
COOKIE_SAMESITE=lax
# Opcional: compartilha o cookie entre subdomínios (ex.: .viu.app)
COOKIE_DOMAIN=

# Sentry (opcional — error tracking). Sem DSN o SDK não é iniciado e nada é
# enviado; o servidor roda igual. Criar em: https://sentry.io → Projeto → DSN
SENTRY_DSN=

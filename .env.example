# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/viu"

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="substitua_por_uma_chave_aleatoria_de_no_minimo_32_caracteres"
JWT_EXPIRES_IN=7d

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000

# Rate limit global da API (default: 100 requisições por 15 minutes)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15 minutes

# Quantos proxies existem na frente da API. TODO limite por IP depende disto:
# atrás de um proxy (Railway, Fly, Nginx) sem configurar, `request.ip` é o IP do
# proxy e o produto inteiro passa a dividir o mesmo balde — o sexto cadastro do
# dia seria recusado mesmo vindo de outra pessoa.
# É um número, e não true/false, de propósito: confiar na cadeia inteira de
# X-Forwarded-For deixa o cliente forjar o próprio IP e nunca bater no limite.
# Railway/Vercel/Fly: 1. Rodando local, sem proxy: 0.
TRUST_PROXY_HOPS=0

# Cadastro público (POST /auth/register).
# A hora conta tentativas (memória); o dia conta contas efetivamente criadas
# (audit log), que é o que sobrevive a deploy.
REGISTRO_MAX_HORA=5
REGISTRO_MAX_DIA=15
# Clientes que um designer cadastra por hora pelo wizard (chave: o usuário).
CLIENTES_MAX_HORA=20
# Tentativas de login por IP a cada 15 minutos.
LOGIN_MAX_15MIN=10

# Cloudflare Turnstile no cadastro. Desligado, o registro funciona sem widget —
# é assim que se desenvolve local. Em beta público, ligue.
# Chaves em: dash.cloudflare.com → Turnstile → Add site
# A site key é pública e vai no frontend (NEXT_PUBLIC_TURNSTILE_SITE_KEY).
# Ligar sem o segredo aqui derruba o boot de propósito: um captcha que não
# valida nada é pior do que não ter captcha, porque o time acha que tem.
CAPTCHA_ENABLED=false
TURNSTILE_SECRET_KEY=

# Exige e-mail confirmado para criar projeto, subir arte/versão e gerar link.
# Só ligue depois de confirmar, com um cadastro real, que o e-mail do Resend
# chega: com isto ligado e o e-mail não saindo, ninguém consegue começar a usar
# o produto — e a tela não tem como explicar por quê.
EXIGIR_EMAIL_VERIFICADO=false

# Teto de quem não tem assinatura ativa. Sem isto o plano gratuito é ilimitado.
BETA_MAX_PROJETOS=3
BETA_MAX_ARTES=20

# URL pública do frontend (usada em links compartilhados)
FRONTEND_URL=http://localhost:3000

# Cloudflare R2 Storage
# Endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2_access_key_id>
R2_SECRET_ACCESS_KEY=<r2_secret_access_key>
R2_BUCKET=viu

# OpenAI (opcional — transcrição e TTS de feedbacks de áudio)
OPENAI_API_KEY=

# Resend (email transacional — recuperação de senha)
# Criar em: https://resend.com → API Keys
RESEND_API_KEY=
# Remetente verificado no Resend (deve ser um domínio seu)
EMAIL_FROM=VIU <noreply@seudominio.com>

# Cookies de sessão. 'lax' serve quando app e API compartilham o site
# registrável (viu.app / api.viu.app, ou localhost:3000 / localhost:3001) e já
# protege contra CSRF. Domínios diferentes exigem 'none' — que só funciona com
# HTTPS e deixa a guarda de origem como única defesa contra CSRF.
COOKIE_SAMESITE=lax
# Opcional: compartilha o cookie entre subdomínios (ex.: .viu.app)
COOKIE_DOMAIN=

# Mercado Pago (cobrança de faturas por PIX e assinaturas).
# MP_WEBHOOK_SECRET é o que valida a assinatura dos webhooks recebidos —
# sem ele qualquer um poderia forjar uma confirmação de pagamento.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Sentry (opcional — error tracking). Sem DSN o SDK não é iniciado e nada é
# enviado; o servidor roda igual. Criar em: https://sentry.io → Projeto → DSN
SENTRY_DSN=

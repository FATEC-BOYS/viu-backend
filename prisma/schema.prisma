generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// TODO(architecture): Introduce Workspace model for multi-tenant isolation.
// Every entity (Projeto, Arte, Tarefa, etc.) should belong to a Workspace.
// This enables:
//   - Strict row-level isolation between companies (no cross-tenant ID guessing)
//   - Per-workspace billing / Plano assignments
//   - Onboarding: create workspace → invite users
// Migration path:
//   1. Add model Workspace { id, nome, planoId, criadoEm }
//   2. Add workspaceId to Usuario, Projeto, Arte, Tarefa, Fatura, Assinatura
//   3. Update all Prisma queries to filter by workspaceId
//   4. Auth middleware attaches workspace to request context
//   5. Migrate existing data: one workspace per existing Designer

// 👤 Usuários
model Usuario {
  id       String  @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  email    String  @unique
  senha    String?
  nome     String
  telefone String?
  avatar   String?
  tipo     String  @default("DESIGNER") // TipoUsuario: DESIGNER, CLIENTE, ADMIN
  ativo    Boolean @default(true)

  // 2FA
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[] @default([])

  // Email verification
  emailVerificado           Boolean   @default(false)
  emailVerificacaoToken     String?   @unique
  emailVerificacaoExpiresAt DateTime?

  // Password reset
  passwordResetToken     String?   @unique
  passwordResetExpiresAt DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  /// Quando a conta foi excluída a pedido do titular (LGPD Art. 18 IV).
  ///
  /// Preenchido significa "excluída"; nulo com `ativo: false` significa apenas
  /// desativada. Sem esta coluna os dois casos eram indistinguíveis — ficava só
  /// `ativo: false`, que não diz nem o que aconteceu nem quando.
  ///
  /// A data em si NÃO é dado pessoal do titular: é registro do atendimento ao
  /// pedido dele, e é o que permite demonstrar depois que a exclusão aconteceu
  /// e em que momento. Some com o resto se a linha for apagada de vez.
  excluidoEm DateTime?

  projetosDesigner Projeto[]       @relation("ProjetoDesigner")
  projetosCliente  Projeto[]       @relation("ProjetoCliente")
  artes            Arte[]          @relation("ArteAutor")
  arteVersoes      ArteVersao[]    @relation("ArteVersaoCriador")
  feedbacks        Feedback[]      @relation("FeedbackAutor")
  aprovacoes       Aprovacao[]     @relation("AprovacaoAprovador")
  tarefas          Tarefa[]        @relation("TarefaResponsavel")
  notificacoes     Notificacao[]   @relation("NotificacaoUsuario")
  sessoes          Sessao[]        @relation("SessaoUsuario")
  impersonacoes    Sessao[]        @relation("SessaoImpersonador")
  auditLogs        AuditLog[]      @relation("AuditLogUsuario")
  securityEvents   SecurityEvent[] @relation("SecurityEventUsuario")

  assinaturas         Assinatura[] @relation("AssinaturaUsuario")
  pagamentos          Pagamento[]  @relation("PagamentosUsuario")
  chavesPix           ChavePix[]   @relation("ChavesPixUsuario")
  saques              Saque[]      @relation("SaquesDesigner")
  faturasComoCliente  Fatura[]     @relation("FaturasCliente")
  faturasComoDesigner Fatura[]     @relation("FaturasDesigner")

  aceites         AceiteContratual[]
  aceitesTermos   AceiteTermos[]
  disputasAbertas Disputa[]          @relation("DisputasAbertas")

  linksCompartilhados LinkCompartilhado[] @relation("LinksCriador")

  equipesComoDono Equipe[]       @relation("EquipeDono")
  equipesMembro   EquipeMembro[]

  convitesRecebidos ConviteProjeto[] @relation("ConviteConvidado")
  convitesEnviados  ConviteProjeto[] @relation("ConviteConvidadoPor")

  equipeConvitesRecebidos EquipeConvite[] @relation("EquipeConviteConvidado")
  equipeConvitesEnviados  EquipeConvite[] @relation("EquipeConviteConvidadoPor")

  ledgerEntries LedgerEntry[] @relation("LedgerDesigner")

  vinculosComoDesigner VinculoCliente[] @relation("VinculosComoDesigner")
  vinculosComoCliente  VinculoCliente[] @relation("VinculosComoCliente")

  @@index([email])
  @@index([tipo])
  @@index([ativo])
  @@index([criadoEm])
  @@index([excluidoEm])
  @@map("usuarios")
}

// 📁 Projetos
model Projeto {
  id        String    @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  nome      String
  descricao String?
  status    String    @default("EM_ANDAMENTO")
  orcamento Int?
  prazo     DateTime?

  designerId String
  designer   Usuario @relation("ProjetoDesigner", fields: [designerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  clienteId  String
  cliente    Usuario @relation("ProjetoCliente", fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  equipeId String?
  equipe   Equipe? @relation(fields: [equipeId], references: [id], onDelete: SetNull)

  artes    Arte[]   @relation("ArtesProjeto")
  tarefas  Tarefa[] @relation("TarefasProjeto")
  faturas  Fatura[] @relation("FaturasProjeto")
  aceites  AceiteContratual[]
  disputas Disputa[]
  convites ConviteProjeto[]
  termos    TermosProjeto?
  contratos ContratoProjeto[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@index([designerId])
  @@index([clienteId])
  @@index([status])
  @@index([equipeId])
  @@index([criadoEm])
  @@map("projetos")
}

// 🎨 Artes/Arquivos
model Arte {
  id        String  @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  nome      String
  descricao String?
  arquivo   String
  tipo      String
  tamanho   BigInt
  versao    Int     @default(1)
  status    String  @default("EM_ANALISE")

  projetoId String
  projeto   Projeto @relation("ArtesProjeto", fields: [projetoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  autorId   String
  autor     Usuario @relation("ArteAutor", fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  feedbacks           Feedback[]          @relation("FeedbacksArte")
  aprovacoes          Aprovacao[]         @relation("AprovacoesArte")
  linksCompartilhados LinkCompartilhado[] @relation("LinksArte")
  versoes             ArteVersao[]        @relation("ArteVersoes")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@index([projetoId])
  @@index([autorId])
  @@index([status])
  @@index([tipo])
  @@index([criadoEm])
  @@map("artes")
}

// 📷 Versões de Arte
model ArteVersao {
  id        String   @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  numero    Int
  arquivo   String
  tipo      String
  tamanho   BigInt
  descricao String?
  criadoEm  DateTime @default(now())

  arteId      String
  arte        Arte    @relation("ArteVersoes", fields: [arteId], references: [id], onDelete: Cascade)
  criadoPorId String
  criadoPor   Usuario @relation("ArteVersaoCriador", fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@index([arteId])
  @@map("arte_versoes")
}

// 💬 Feedbacks
model Feedback {
  id       String  @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  conteudo String
  tipo     String  @default("TEXTO")

  /// Sobre qual versão da arte este comentário foi feito.
  ///
  /// Número e não FK, pelo mesmo motivo de `Aprovacao.versaoNumero`:
  /// `createArte` não gera linha em `ArteVersao`, então a v1 de toda arte
  /// ficaria com FK nula — justamente o caso mais comum.
  ///
  /// Existe porque a cláusula 3.2 do anexo define rodada como "o conjunto de
  /// feedbacks do Cliente sobre uma mesma versão". Sem este campo isso só se
  /// obtinha por dedução de timestamp, que erra exatamente na hora que vira
  /// discussão: o comentário escrito enquanto o designer sobe a versão nova é
  /// atribuído à errada.
  ///
  /// Anulável, e o legado fica nulo de propósito. Preencher linha antiga por
  /// heurística produziria um palpite indistinguível de um registro — e este
  /// dado existe para servir de prova numa disputa. A tela mostra "sem versão
  /// registrada" em vez de um número plausível.
  versaoNumero Int?

  arquivo  String?
  posicaoX Float?
  posicaoY Float?

  transcricao String?
  audioGerado String?

  // false = comentário interno (não aparece em links públicos de revisão)
  publico Boolean @default(true)

  // Threading: respostas a outro feedback na mesma arte
  parentId     String?
  parent       Feedback?  @relation("FeedbackThread", fields: [parentId], references: [id], onDelete: SetNull)
  respostas    Feedback[] @relation("FeedbackThread")
  // Thread fechada por um líder/revisor
  resolvidoEm  DateTime?
  resolvidoPor String?

  arteId  String
  arte    Arte    @relation("FeedbacksArte", fields: [arteId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  autorId String
  autor   Usuario @relation("FeedbackAutor", fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  criadoEm DateTime @default(now())

  @@index([arteId])
  @@index([autorId])
  @@index([tipo])
  @@index([parentId])
  @@index([criadoEm])
  @@index([arteId, versaoNumero])
  @@map("feedbacks")
}

// ✅ Aprovações
model Aprovacao {
  id         String  @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  status     String  @default("PENDENTE")
  comentario String?
  // Qual entrega esta decisão aprova. Número, não FK: createArte não gera linha
  // em ArteVersao, então a v1 de toda arte ficaria com FK nula — justamente o
  // caso mais comum.
  versaoNumero Int?
  // Soft delete: registros de aprovação são evidência contratual — nunca deletados fisicamente
  deletedAt  DateTime?

  arteId      String
  arte        Arte    @relation("AprovacoesArte", fields: [arteId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  aprovadorId String
  aprovador   Usuario @relation("AprovacaoAprovador", fields: [aprovadorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /**
   * Quando a aprovação saiu de PENDENTE.
   *
   * Sem isto a linha vai de PENDENTE a APROVADO sem deixar rastro de quando, e
   * o produto não consegue medir a própria promessa: o tempo entre pedir e
   * receber a decisão. Nulo em aprovação ainda pendente — e nas decididas
   * antes desta coluna existir, que não têm como ser recuperadas.
   */
  decididoEm DateTime?

  criadoEm DateTime @default(now())

  // Trava a duplicata que o botão "Solicitar aprovação" cria com dois cliques:
  // a rota de decisão busca com limit=1 e pega [0], então linhas repetidas
  // fazem a decisão do cliente cair numa arbitrária.
  @@unique([arteId, aprovadorId, versaoNumero])
  @@index([arteId])
  @@index([aprovadorId])
  @@index([status])
  @@index([deletedAt])
  @@index([criadoEm])
  @@index([decididoEm])
  @@map("aprovacoes")
}

// 📋 Tarefas
model Tarefa {
  id         String    @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  titulo     String
  descricao  String?
  status     String    @default("PENDENTE")
  prioridade String    @default("MEDIA")
  prazo      DateTime?

  projetoId     String?
  projeto       Projeto? @relation("TarefasProjeto", fields: [projetoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  responsavelId String
  responsavel   Usuario  @relation("TarefaResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@index([projetoId])
  @@index([responsavelId])
  @@index([status])
  @@index([prioridade])
  @@index([prazo])
  @@map("tarefas")
}

// 🔔 Notificações
model Notificacao {
  id       String  @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  titulo   String
  conteudo String
  tipo     String
  canal    String  @default("SISTEMA")
  lida     Boolean @default(false)

  usuarioId String
  usuario   Usuario @relation("NotificacaoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  criadoEm DateTime @default(now())

  @@index([usuarioId])
  @@index([tipo])
  @@index([lida])
  @@index([criadoEm])
  @@map("notificacoes")
}

// 🔐 Sessões
model Sessao {
  id               String    @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  token            String    @unique
  expiresAt        DateTime
  refreshToken     String?   @unique
  refreshExpiresAt DateTime?
  ativo            Boolean   @default(true)

  usuarioId String
  usuario   Usuario @relation("SessaoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Quando preenchido, esta sessão É UMA IMPERSONAÇÃO: o `usuarioId` acima é
  /// de quem está sendo visto, e este campo diz qual admin está dentro.
  ///
  /// A fonte da verdade é esta coluna, e não uma claim no JWT. Com a claim,
  /// revogar a impersonação no banco não teria efeito enquanto o token não
  /// expirasse — e duas fontes para o mesmo fato acabam discordando. Aqui
  /// `authenticate` já lê a linha da sessão a cada requisição.
  impersonadoPorId String?
  impersonadoPor   Usuario? @relation("SessaoImpersonador", fields: [impersonadoPorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  criadoEm DateTime @default(now())

  @@index([usuarioId])
  @@index([token])
  @@index([refreshToken])
  @@index([expiresAt])
  @@index([ativo])
  @@index([impersonadoPorId])
  @@map("sessoes")
}

// 📝 Audit Logs
model AuditLog {
  id String @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))

  action     String  @db.Text
  resource   String  @db.Text
  resourceId String? @db.Text

  details   Json?   @db.JsonB
  ipAddress String? @db.Text
  userAgent String? @db.Text

  status       String  @db.Text
  errorMessage String? @db.Text

  usuarioId String?
  usuario   Usuario? @relation("AuditLogUsuario", fields: [usuarioId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  criadoEm DateTime @default(now())

  @@index([usuarioId])
  @@index([action])
  @@index([resource])
  @@index([status])
  @@index([criadoEm])
  // O teto diário de cadastros conta linhas REGISTER deste IP nas últimas 24h.
  // Sem o índice composto a consulta varre por data e filtra IP depois — e ela
  // roda em toda tentativa de cadastro.
  @@index([ipAddress, criadoEm])
  @@map("audit_logs")
}

// 🔒 Security Events
model SecurityEvent {
  id String @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))

  eventType String @db.Text
  severity  String @db.Text

  description String @db.Text
  details     Json?  @db.JsonB

  ipAddress String? @db.Text
  userAgent String? @db.Text
  location  String? @db.Text

  usuarioId String?
  usuario   Usuario? @relation("SecurityEventUsuario", fields: [usuarioId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?   @db.Text

  criadoEm DateTime @default(now())

  @@index([usuarioId])
  @@index([eventType])
  @@index([severity])
  @@index([resolved])
  @@index([criadoEm])
  @@map("security_events")
}

// 🔗 Links Compartilhados
model LinkCompartilhado {
  id String @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))

  token String @unique
  tipo  String @db.Text

  arteId String?
  arte   Arte?   @relation("LinksArte", fields: [arteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  criadorId String?
  criador   Usuario? @relation("LinksCriador", fields: [criadorId], references: [id], onDelete: SetNull)

  somenteLeitura Boolean   @default(true)
  expiraEm       DateTime?

  // Segurança de links públicos
  revogado        Boolean @default(false)  // revogação explícita independente de expiração
  limiteTentativas Int?                   // null = sem limite de acessos
  acessos         Int     @default(0)     // contador de acessos ao preview

  criadoEm DateTime @default(now())

  @@index([token])
  @@index([arteId])
  @@index([criadorId])
  @@index([expiraEm])
  @@index([revogado])
  @@map("link_compartilhado")
}

// ====== SISTEMA DE PAGAMENTOS ======

model Plano {
  id               String  @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  nome             String
  tipo             String
  precoMensal      Int
  precoAnual       Int?
  taxaPlataforma   Float   @default(0.10)
  limitesProjetos  Int?
  limitesArtes     Int?
  limitesStorageMb Int?
  descricao        String?
  ativo            Boolean @default(true)

  assinaturas Assinatura[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@index([tipo])
  @@index([ativo])
  @@map("planos")
}

model Assinatura {
  id                  String    @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  status              String    @default("PENDENTE")
  periodoInicio       DateTime?
  periodoFim          DateTime?
  renovacaoAutomatica Boolean   @default(true)
  mpPreapprovalId     String?   @unique
  mpPlanId            String?

  usuarioId String
  usuario   Usuario @relation("AssinaturaUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  planoId   String
  plano     Plano   @relation(fields: [planoId], references: [id])

  pagamentos Pagamento[] @relation("PagamentosAssinatura")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@index([usuarioId])
  @@index([status])
  @@map("assinaturas")
}

model Fatura {
  id                   String    @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  valor                Int
  taxaPlataforma       Int
  valorLiquidoDesigner Int
  status               String    @default("PENDENTE")
  dataVencimento       DateTime?
  dataPagamento        DateTime?
  descricao            String?

  projetoId  String
  projeto    Projeto @relation("FaturasProjeto", fields: [projetoId], references: [id])
  clienteId  String
  cliente    Usuario @relation("FaturasCliente", fields: [clienteId], references: [id])
  designerId String
  designer   Usuario @relation("FaturasDesigner", fields: [designerId], references: [id])

  pagamento Pagamento? @relation("PagamentoFatura")
  disputas  Disputa[]  @relation("DisputasFatura")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@index([projetoId])
  @@index([clienteId])
  @@index([designerId])
  @@index([status])
  @@map("faturas")
}

model Pagamento {
  id              String  @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  tipo            String
  status          String  @default("PENDENTE")
  valor           Int
  metodoPagamento String?
  mpPaymentId     String? @unique
  mpPreferenceId  String?
  mpStatus        String?
  mpQrCode        String?
  mpQrCodeText    String?

  usuarioId    String
  usuario      Usuario     @relation("PagamentosUsuario", fields: [usuarioId], references: [id])
  assinaturaId String?
  assinatura   Assinatura? @relation("PagamentosAssinatura", fields: [assinaturaId], references: [id])
  faturaId     String?     @unique
  fatura       Fatura?     @relation("PagamentoFatura", fields: [faturaId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@index([usuarioId])
  @@index([status])
  @@index([tipo])
  @@index([mpPaymentId])
  @@map("pagamentos")
}

model ChavePix {
  id      String  @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  tipo    String
  chave   String
  titular String
  ativa   Boolean @default(true)

  usuarioId String
  usuario   Usuario @relation("ChavesPixUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  saques Saque[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@unique([usuarioId, chave])
  @@index([usuarioId])
  @@map("chaves_pix")
}

model Saque {
  id         String  @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  valor      Int
  status     String  @default("SOLICITADO")
  mpPayoutId String? @unique

  designerId String
  designer   Usuario  @relation("SaquesDesigner", fields: [designerId], references: [id])
  chavePixId String
  chavePix   ChavePix @relation(fields: [chavePixId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@index([designerId])
  @@index([status])
  @@map("saques")
}

// ====== PROTEÇÃO LEGAL ======

/// Os termos comerciais que o anexo de revisão renderiza.
///
/// Tabela separada de `Projeto`, e não nove colunas lá, por dois motivos
/// práticos: um aditivo precisa congelar exatamente este conjunto e comparar
/// duas versões dele — com um objeto coeso isso é um diff, com colunas
/// espalhadas vira conferência manual; e "termos incompletos", que é o que o
/// aviso da fatura consulta, passa a ser uma pergunta só.
///
/// Todo campo é opcional no banco porque o projeto nasce antes de alguém
/// combinar os termos. Quem decide se está completo é `termosCompletos()`, em
/// um lugar só, usada pelo aviso da tela e pelo portão — duas listas separadas
/// divergiriam no primeiro campo novo.
model TermosProjeto {
  id        String  @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  projetoId String  @unique
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  /// Cláusula 3.1 — rodadas incluídas no valor acordado, POR ENTREGA.
  ///
  /// Entrega é cada peça registrada no VIU (cada arte), não o projeto inteiro:
  /// um projeto com três peças tem este número de rodadas para cada uma. O
  /// nome do campo fala do projeto porque é onde o valor padrão é definido —
  /// o que ele governa é a entrega.
  rodadasIncluidas Int?

  /// Cláusula 4.1 — prazo do cliente para comentar ou aprovar.
  ///
  /// Sem efeito automático: a 4.2 ficou na Opção A (sem aprovação tácita), então
  /// isto é prazo combinado e exibido, nunca gatilho de mudança de estado.
  prazoRevisaoDiasUteis Int?

  /// Cláusula 7.2 — os limites da licença.
  ///
  /// "Peças cobertas" não vira campo: é constante do template ("versões finais
  /// aprovadas da etapa quitada"), não decisão por projeto.
  licencaFinalidade String?
  licencaTerritorio String?

  /// INDETERMINADO | ATE_DATA. Dois campos e não uma data nula significando
  /// "sem prazo": nulo teria que dizer "indeterminado" e "ninguém respondeu" ao
  /// mesmo tempo, e é o segundo que o aviso precisa enxergar.
  licencaPrazo    String?
  licencaPrazoAte DateTime?

  /// Boolean? e não @default(false) pela mesma razão: com default, "respondeu
  /// que não" e "não respondeu" ficam idênticos.
  exclusividade    Boolean?
  exclusividadeAte DateTime?

  /// NAO_INCLUSOS | INCLUSOS_APOS_QUITACAO | TAXA_EXTRA
  arquivosFonte String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@map("termos_projeto")
}

/// O anexo de revisão congelado — o documento que as partes aceitaram.
///
/// `TermosProjeto` guarda o estado corrente e muda quando as partes
/// renegociam. Aqui nada muda: `texto` é o que elas leram, palavra por palavra,
/// e é sobre ele que o `hash` responde. Re-renderizar a partir do projeto
/// pareceria economia e seria o fim da prova — `Projeto.orcamento` e os termos
/// vão mudar, e o contrato mudaria junto, em silêncio.
///
/// Um aditivo não altera a linha: cria a versão seguinte. A anterior fica
/// SUBSTITUIDA, intacta, com os aceites dela.
model ContratoProjeto {
  id        String  @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  versao Int

  /// VIGENTE | SUBSTITUIDO. Um projeto tem no máximo um vigente por vez, o que
  /// o serviço garante ao gerar a versão seguinte.
  status String @default("VIGENTE")

  /// Texto puro, e não markdown, por prova e não por estilo: o `hash` cobre
  /// exatamente o que esteve na tela. Com markdown as partes concordariam com
  /// o documento renderizado enquanto o hash guardaria o código-fonte dele —
  /// duas coisas diferentes, e a diferença apareceria justamente quando alguém
  /// contestasse o que aceitou.
  texto String

  /// sha256 hexadecimal de `texto`.
  hash String

  /// Tudo que o template consumiu para produzir `texto`: as partes (nome e
  /// e-mail congelados — `Usuario.nome` muda, o contrato não), o projeto e os
  /// termos. É o que permite comparar duas versões num aditivo sem interpretar
  /// prosa.
  dados Json @db.JsonB

  /// Qual redação gerou este texto, ex.: "anexo-revisao-pi@2". Sobe a cada
  /// mudança de cláusula; é o que responde "o que exatamente foi aceito".
  templateVersao String

  /// Se a redação usada já passara por advogado quando este contrato nasceu.
  /// Fica gravado, e não derivado do template atual, porque a pergunta é sobre
  /// o momento do aceite — não sobre hoje.
  revisadoJuridicamente Boolean @default(false)

  aceites  AceiteContratual[]
  criadoEm DateTime           @default(now())

  @@unique([projetoId, versao])
  @@index([projetoId, status])
  @@map("contratos_projeto")
}

/// O aceite de uma versão específica do contrato.
///
/// A unicidade era `[usuarioId, projetoId]` e `registrarAceite` era `upsert`:
/// aceitar a v2 sobrescrevia a linha da v1 — trocava `termoVersao`, `ip` e
/// `userAgent` — e a prova de que alguém havia aceitado a redação anterior
/// deixava de existir. Aceite é fato histórico: acumula, não atualiza. Agora a
/// chave é `[usuarioId, contratoId]`, e cada versão guarda o próprio aceite.
model AceiteContratual {
  id        String  @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  ip        String?
  userAgent String?

  /// O hash do texto que estava na tela naquele clique.
  ///
  /// Redundante com `contrato.hash` de propósito: se a linha do contrato for
  /// alterada depois, o aceite carrega a própria cópia do que foi acordado.
  hashAceito String?

  /// DESIGNER ou CLIENTE no momento do aceite. Congelado porque o papel da
  /// pessoa no projeto pode mudar, e a pergunta é quem ela era ao aceitar.
  papel String?

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Anulável só por causa do legado: linhas gravadas antes de existir texto
  /// congelado não têm contrato a que se referir. Nulo aqui significa "aceite
  /// anterior ao texto congelado", que é a verdade — melhor do que inventar um
  /// contrato retroativo para satisfazer a chave estrangeira.
  contratoId String?
  contrato   ContratoProjeto? @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  /// Legado. `projetoId` continua porque as linhas antigas dependem dele;
  /// `termoVersao` era o ponteiro para um documento que nunca existiu.
  projetoId   String
  projeto     Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  termoVersao String  @default("1.0")

  criadoEm DateTime @default(now())

  @@unique([usuarioId, contratoId])
  @@index([usuarioId])
  @@index([projetoId])
  @@index([contratoId])
  @@map("aceites_contratuais")
}

model Disputa {
  id             String    @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  tipo           String
  status         String    @default("ABERTA")
  descricao      String
  resolucao      String?
  saldoBloqueado Int       @default(0)
  resolvidaEm    DateTime?

  abertaPorId String
  abertaPor   Usuario @relation("DisputasAbertas", fields: [abertaPorId], references: [id])
  projetoId   String
  projeto     Projeto @relation(fields: [projetoId], references: [id])
  faturaId    String?
  fatura      Fatura? @relation("DisputasFatura", fields: [faturaId], references: [id])

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@index([projetoId])
  @@index([abertaPorId])
  @@index([status])
  @@map("disputas")
}

// ====== EQUIPES ======

model Equipe {
  id   String @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  nome String
  slug String @unique

  donoPrincipalId String
  donoPrincipal   Usuario @relation("EquipeDono", fields: [donoPrincipalId], references: [id])

  membros  EquipeMembro[]
  projetos Projeto[]
  convites EquipeConvite[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@index([donoPrincipalId])
  @@index([slug])
  @@map("equipes")
}

model EquipeMembro {
  equipeId  String
  equipe    Equipe  @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  // LIDER | DESIGNER | REVISOR | CLIENTE
  papel     String

  criadoEm DateTime @default(now())

  @@id([equipeId, usuarioId])
  @@index([usuarioId])
  @@map("equipe_membros")
}

// ====== LEDGER FINANCEIRO ======

model LedgerEntry {
  id         String  @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  // CREDITO (fatura paga) ou DEBITO (saque concluído)
  tipo       String
  valor      Int
  descricao  String
  // "fatura:<id>" ou "saque:<id>" — rastreabilidade
  referencia String?

  designerId String
  designer   Usuario @relation("LedgerDesigner", fields: [designerId], references: [id])

  criadoEm DateTime @default(now())

  @@index([designerId])
  @@index([tipo])
  @@index([criadoEm])
  @@map("ledger_entries")
}

// ====== WEBHOOKS ======

model WebhookLog {
  id         String    @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  // MP x-request-id — chave de idempotência: impede reprocessar o mesmo evento
  externalId String    @unique
  tipo       String
  // RECEBIDO | PROCESSADO | ERRO | IGNORADO
  status     String    @default("RECEBIDO")
  payload    Json
  tentativas Int       @default(0)
  erro       String?
  processadoEm DateTime?
  criadoEm   DateTime  @default(now())

  @@index([status])
  @@index([criadoEm])
  @@map("webhook_logs")
}

// ====== CONVITES DE EQUIPE ======

model EquipeConvite {
  id        String   @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  tokenHash String   @unique
  // PENDENTE | ACEITO | RECUSADO | CANCELADO | EXPIRADO
  status    String   @default("PENDENTE")
  // Papel proposto: LIDER | DESIGNER | REVISOR | CLIENTE
  papel     String
  expiraEm  DateTime

  equipeId       String
  equipe         Equipe  @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  convidadoId    String
  convidado      Usuario @relation("EquipeConviteConvidado", fields: [convidadoId], references: [id], onDelete: Cascade)
  convidadoPorId String
  convidadoPor   Usuario @relation("EquipeConviteConvidadoPor", fields: [convidadoPorId], references: [id], onDelete: Cascade)

  criadoEm    DateTime  @default(now())
  respondidoEm DateTime?

  @@index([equipeId])
  @@index([convidadoId])
  @@index([status])
  @@map("equipe_convites")
}

// ====== CONVITES DE PROJETO ======

model ConviteProjeto {
  id        String   @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))
  // SHA-256 do token raw — token raw nunca é persistido
  tokenHash String   @unique
  // PENDENTE | ACEITO | RECUSADO | CANCELADO | EXPIRADO
  status    String   @default("PENDENTE")
  expiraEm  DateTime

  projetoId      String
  projeto        Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  convidadoId    String
  convidado      Usuario @relation("ConviteConvidado", fields: [convidadoId], references: [id], onDelete: Cascade)
  convidadoPorId String
  convidadoPor   Usuario @relation("ConviteConvidadoPor", fields: [convidadoPorId], references: [id], onDelete: Cascade)

  criadoEm    DateTime @default(now())
  respondidoEm DateTime?

  @@index([projetoId])
  @@index([convidadoId])
  @@index([status])
  @@map("convites_projeto")
}

// 🤝 Vínculo designer ↔ cliente
//
// O laço entre designer e cliente é implícito: nasce do primeiro projeto em
// comum. Este model existe para registrar a exceção — quando o designer decide
// romper. Romper é só isso: o cliente sai da carteira dele. Projetos, artes,
// feedbacks e faturas já trocados continuam intactos e acessíveis, e a conta
// do cliente não é tocada.
model VinculoCliente {
  id String @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))

  designerId String
  designer   Usuario @relation("VinculosComoDesigner", fields: [designerId], references: [id], onDelete: Cascade)
  clienteId  String
  cliente    Usuario @relation("VinculosComoCliente", fields: [clienteId], references: [id], onDelete: Cascade)

  // null = laço ativo. Preenchido = rompido, com a data em que aconteceu.
  rompidoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt

  @@unique([designerId, clienteId])
  @@index([designerId])
  @@index([clienteId])
  @@index([rompidoEm])
  @@map("vinculos_cliente")
}

/// O aceite dos TERMOS DA PLATAFORMA — VIU ↔ usuário.
///
/// Separado de `AceiteContratual` de propósito, e não por capricho de
/// modelagem: são dois documentos com partes diferentes. `AceiteContratual`
/// exige `projetoId`, porque o anexo de revisão rege UM projeto entre designer
/// e cliente. Os termos da plataforma não têm projeto — reger a relação com o
/// VIU é o que eles fazem — e enfiá-los na outra tabela reproduziria
/// exatamente a confusão que este modelo existe para desfazer: o produto
/// gravava aceite de termos na criação do projeto, apontando para um
/// `termoVersao: "1.0"` que não existia em lugar nenhum.
model AceiteTermos {
  id String @id @default(dbgenerated("('c'::text || encode(gen_random_bytes(12), 'hex'::text))"))

  /// A versão do texto aceito, ex. "termos-plataforma@1". Responde O QUE a
  /// pessoa aceitou; sem isto o registro só prova que ela clicou.
  versao String

  /// O sha256 do texto naquele clique. Redundante com o arquivo no repositório
  /// de propósito: se a redação da mesma versão for alterada por engano, o
  /// aceite carrega a própria cópia do que foi lido.
  hash String

  /// Onde e com o quê — Lei 14.063/20. Anuláveis porque proxy e cliente nem
  /// sempre informam, e um aceite sem IP continua sendo um aceite.
  ip        String?
  userAgent String?

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  /// Aceitar a mesma versão duas vezes não duplica: um clique repetido no
  /// cadastro, ou um reenvio de formulário, é o mesmo fato. Versão NOVA gera
  /// linha nova, e a anterior fica — aceite é histórico, não se atualiza.
  @@unique([usuarioId, versao])
  @@index([usuarioId])
  @@map("aceites_termos")
}
